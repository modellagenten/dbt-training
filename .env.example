# Kopiere diese Datei nach .env (cp .env.example .env) und passe sie bei Bedarf an.
POSTGRES_DB=ecommerce
POSTGRES_USER=dbt_user
POSTGRES_PASSWORD=dbt_password
# Host-Port für DBeaver. Bei Konflikten mit einer lokalen Postgres-Installation z. B. 5433 setzen.
POSTGRES_PORT=5432
# true: Zeitstempel werden beim ersten Start relativ zu heute verschoben
TIME_SHIFT=true
